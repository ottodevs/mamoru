# TEMPLATE user unit (otto/mamoru#293, review of #202 r3, r5, r6): OnFailure of mamoru-guardian. Not installed by anything
# in the repo. Posts a fixed line (no log text) through an INDEPENDENT channel: its own env file, holding
# MAMORU_GUARDIAN_ALERT_WEBHOOK_FILE (a second Mattermost incoming webhook, e.g. for ops-mamoru, in its own 0600 file).
# It also loads the guardian's env file, optional ('-'), only to learn MAMORU_GUARDIAN_WEBHOOK_FILE and refuse when both
# name the same webhook (same file, inode or URL); it never posts through it and never reads the guardian key.
# If it cannot post, for any reason, it exits non-zero and lands in `failed` itself: fleet-watchdog then sees two failed
# units in #infra.
[Unit]
Description=Mamoru guardian: alert on %i failure

[Service]
Type=oneshot
WorkingDirectory=%h/box/src/mamoru.workspace/mamoru
EnvironmentFile=-%h/.config/mamoru-guardian/env
EnvironmentFile=%h/.config/mamoru-guardian-alert/env
ExecStart=/etc/profiles/per-user/otto/bin/bun apps/mamoru-guardian/src/unit-alert.ts %i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

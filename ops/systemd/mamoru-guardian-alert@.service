# TEMPLATE user unit (otto/mamoru#293, review of #202 r3): OnFailure of mamoru-guardian. Posts a fixed line (no log text)
# through the guardian's own webhook file. Not installed by anything in the repo.
[Unit]
Description=Mamoru guardian: alert on %i failure

[Service]
Type=oneshot
WorkingDirectory=%h/box/src/mamoru.workspace/mamoru
EnvironmentFile=%h/.config/mamoru-guardian/env
ExecStart=/etc/profiles/per-user/otto/bin/bun apps/mamoru-guardian/src/unit-alert.ts %i

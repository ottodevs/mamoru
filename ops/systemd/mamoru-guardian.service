# TEMPLATE user unit (systemctl --user), otto/mamoru#293 item 6 (spec 010 I4/I7). Not installed by anything in the repo.
# Install at ~/.config/systemd/user/mamoru-guardian.service; see ops/systemd/README.md and apps/mamoru-guardian/README.md.
#
# The guardian is a SEPARATE process from the operator: its own key (MAMORU_GUARDIAN_KEY_FILE, 0600, never in the env
# file itself), its own state dir, no shared code path. The operator unit never reads this key or this env file.
#
# WorkingDirectory is a checkout of the repo with `bun install` done (adjust to wherever you keep it; unlike the operator
# unit there is no deploy tooling yet). The EnvironmentFile holds only names from the README (RPC URLs, paths), no key.
[Unit]
Description=Mamoru guardian watcher (setReady readback, registry and remote Safe alerts)
After=network-online.target
Wants=network-online.target
# Review of #202 r3 (Sol 2): never give up on a transient failure. systemd restarts it with a growing backoff (30 s up to
# 1 h); the guardian itself pages a startup failure (once an hour, src/main.ts pageStartupFailure).
# Review of #202 r5 (Sol 1): a configuration error (bad or missing setting, unusable webhook file, wrong key, RPC on another
# chain) exits 78 (EX_CONFIG). RestartPreventExitStatus=78 below stops the restarts, the unit enters `failed`, and OnFailure=
# pages through mamoru-guardian-alert@, whose channel is independent of the guardian's webhook (its own env file).
# fleet-watchdog's failed/crash-loop check (~/box/sys/fleet-watchdog, every 15 min, #infra) also sees both states.
StartLimitIntervalSec=0
OnFailure=mamoru-guardian-alert@%N.service

[Service]
Type=simple
WorkingDirectory=%h/box/src/mamoru.workspace/mamoru
EnvironmentFile=%h/.config/mamoru-guardian/env
ExecStart=/etc/profiles/per-user/otto/bin/bun apps/mamoru-guardian/src/main.ts
Restart=always
RestartSec=30
RestartSteps=8
RestartMaxDelaySec=1h
# EX_CONFIG: restarting cannot fix it; `failed` + OnFailure= instead. Every other exit code keeps restarting.
RestartPreventExitStatus=78
# State file, key and webhook files are 0600; never create anything group/other-readable.
UMask=0077

# Secrets it reads: MAMORU_GUARDIAN_KEY_FILE and MAMORU_GUARDIAN_WEBHOOK_FILE (paths set in the env file above). It never
# reads ~/.config/mamoru-guardian-alert/. Reads the repo and those files, writes only its state dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=%h/.local/state/mamoru-guardian

[Install]
WantedBy=default.target

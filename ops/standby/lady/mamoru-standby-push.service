# Cold standby (otto/mamoru#237): send the operators' encrypted state to the VPS.
[Unit]
Description=Mamoru standby: push encrypted operator state to the VPS
OnFailure=mamoru-standby-alert@%N.service

[Service]
Type=oneshot
TimeoutStartSec=600
ExecStart=%h/.local/share/mamoru-standby/push-bundle.sh

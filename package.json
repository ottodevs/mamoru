{
  "name": "mamoru",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.base.json --noEmit && tsc -p apps/mamoru-app/tsconfig.json --noEmit && tsc -p apps/mamoru-app/test/api --noEmit && tsc -p apps/mamoru-engine/tsconfig.json --noEmit && tsc -p apps/mamoru-operator/tsconfig.json --noEmit && tsc -p apps/mamoru-lab-runner/tsconfig.json --noEmit && tsc -p scripts/release/tsconfig.json --noEmit",
    "test": "bun test packages apps",
    "scenarios": "bun packages/scenarios/runner/cli.ts",
    "scenarios:monad": "bun packages/scenarios/monad/cli.ts",
    "scenarios:monad:deploy-fork": "bun packages/scenarios/monad/deploy-fork.ts",
    "monad:deploy-policies": "bun scripts/monad/deploy-policies.ts",
    "sync:once": "bun run --cwd apps/mamoru-engine sync:once",
    "mb:probe": "bun run --cwd apps/mamoru-engine mb:probe",
    "operator": "bun apps/mamoru-operator/src/main.ts",
    "lab-runner": "bun apps/mamoru-lab-runner/src/cli.ts",
    "release:check": "bun scripts/release/check.ts",
    "deploy:beta": "bun scripts/release/deploy-beta.ts",
    "deploy:prod": "bun scripts/release/deploy-prod.ts",
    "coord": "bun scripts/release/coord.ts",
    "operator:deploy": "bun scripts/release/operator-deploy.ts",
    "review:pr": "bun scripts/release/review-pr.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "7.0.2"
  }
}

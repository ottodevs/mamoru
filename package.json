{
  "name": "mamoru",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.base.json --noEmit && tsc -p apps/mamoru-app/tsconfig.json --noEmit && tsc -p apps/mamoru-app/test/api --noEmit && tsc -p apps/mamoru-engine/tsconfig.json --noEmit && tsc -p apps/mamoru-operator/tsconfig.json --noEmit && tsc -p scripts/release/tsconfig.json --noEmit",
    "test": "bun test packages apps",
    "scenarios": "bun packages/scenarios/runner/cli.ts",
    "sync:once": "bun run --cwd apps/mamoru-engine sync:once",
    "mb:probe": "bun run --cwd apps/mamoru-engine mb:probe",
    "operator": "bun apps/mamoru-operator/src/main.ts",
    "release:check": "bun scripts/release/check.ts",
    "deploy:beta": "bun scripts/release/deploy-beta.ts",
    "deploy:prod": "bun scripts/release/deploy-prod.ts",
    "promote": "bun scripts/release/promote.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "7.0.2"
  }
}

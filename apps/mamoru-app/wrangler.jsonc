{
  // mamoru-app (plan §19.1): the SPA assets plus the Hono API. SESSION_SECRET, OPERATOR_URL and OPERATOR_SECRET are secrets (L0 sets them; locally .dev.vars).
  "name": "mamoru-app",
  "account_id": "ac5100a2c4cec1e240cbd20252ba9213",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  // Plan §19.3: no Node compat unless a pinned dependency needs it; hono, viem and the account packages do not.
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.mamoru.lol", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mamoru",
      "database_id": "682b2a66-d9d4-49e5-ac78-596d002d02ca",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "vars": {
    "MODE": "production",
    "CHAIN_ID": "8453",
    "CORE_DRY_RUN": "true",
    "LIVE_FUNDS": "1"
  },
  "observability": { "enabled": true }
}

{
  // mamoru-app (plan §19.1): the SPA assets plus the Hono API. SESSION_SECRET, OPERATOR_URL and OPERATOR_SECRET are secrets (L0 sets them; locally .dev.vars).
  "name": "mamoru-app",
  "account_id": "ac5100a2c4cec1e240cbd20252ba9213",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  // Plan §19.3: no Node compat unless a pinned dependency needs it; hono, viem and the account packages do not.
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.mamoru.lol", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mamoru",
      "database_id": "682b2a66-d9d4-49e5-ac78-596d002d02ca",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "vars": {
    "MODE": "production",
    "CHAIN_ID": "8453",
    "CORE_DRY_RUN": "true",
    "LIVE_FUNDS": "1"
  },
  // Ethereum RPC reads for the wrong-network notice, per account (accounts/other-chains.ts). ETHEREUM_RPC_URLS is a secret.
  // FEEDBACK_LIMIT (feedback.ts, otto/mamoru#72): 3 posts per 60 s, keyed by device session or a hashed IP. The
  // Mattermost vars (MATTERMOST_URL, MATTERMOST_BOT_TOKEN, MATTERMOST_SUPPORT_CHANNEL_ID, MATTERMOST_FEEDBACK_CHANNEL_ID)
  // are secrets, set separately; unset, a row is still stored and nothing is posted.
  // Every 10 minutes: posts the help and feedback notes that are stored and not yet in Mattermost, and (when the
  // `yield_ledger` ops flag is on — D1, set from /ops, migrations/d1/0012_ops_flags.sql) pulls the operator's
  // GET /snapshot into D1 (worker.ts `scheduled`, otto/mamoru#129). No longer an env var: 0010_yield_ledger.sql /
  // 0009_account_snapshots.sql must still be applied first, and the operator still needs MULTICALL3 on Base, but
  // the on/off switch is the D1 flag both envs share.
  "triggers": { "crons": ["*/10 * * * *"] },
  "ratelimits": [
    { "name": "OTHER_CHAINS_LIMIT", "namespace_id": "117001", "simple": { "limit": 6, "period": 60 } },
    { "name": "FUNDING_CHAIN_LIMIT", "namespace_id": "238001", "simple": { "limit": 6, "period": 60 } },
    { "name": "FEEDBACK_LIMIT", "namespace_id": "72001", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Canary: built from branch `beta`, same D1 and same operator as prod. Opt-in testers, real funds, real data.
  // Secrets (SESSION_SECRET, OPERATOR_URL, OPERATOR_SECRET) are set separately with `wrangler secret put X --env beta`.
  // NOT the same account as prod: __Host- session cookies and the passkey RP ID are both scoped to
  // the browser's hostname, so beta.mamoru.lol always creates a fresh session and a fresh passkey
  // (a new counterfactual Safe), on the same D1 and operator. Do not change the passkey RP ID
  // (location.hostname in src/web/lib/passkey-sign.ts) to "fix" this.
  "env": {
    "beta": {
      "name": "mamoru-app-beta",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "beta.mamoru.lol", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/hooks/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mamoru",
          "database_id": "682b2a66-d9d4-49e5-ac78-596d002d02ca",
          "migrations_dir": "../../migrations/d1"
        }
      ],
      "vars": {
        "MODE": "production",
        "CHAIN_ID": "8453",
        "CORE_DRY_RUN": "true",
        "LIVE_FUNDS": "1"
        // Same D1 and operator as prod (see the canary note above): the `yield_ledger` ops flag is one row in the
        // shared D1, so flipping it on from /ops turns the cron on for both envs at once. Both pulling is harmless
        // (the writer upserts, it does not duplicate rows), it only doubles the read.
      },
      "triggers": { "crons": ["*/10 * * * *"] },
      "ratelimits": [
        { "name": "OTHER_CHAINS_LIMIT", "namespace_id": "117002", "simple": { "limit": 6, "period": 60 } },
        { "name": "FUNDING_CHAIN_LIMIT", "namespace_id": "238002", "simple": { "limit": 6, "period": 60 } },
        { "name": "FEEDBACK_LIMIT", "namespace_id": "72002", "simple": { "limit": 3, "period": 60 } }
      ],
      "observability": { "enabled": true }
    }
  }
}
